/*
 * Huawei TGR-W00, Hisilicon Kirin 9000s (charlotte)
 */

/dts-v1/;

#include "charlotte.dtsi"

/ {
	model = "Huawei TGR-W00";
	compatible = "hisilicon,charlotte";

	chosen {
		bootargs = "earlycon=uart_v500,mmio32,0xffb82000 console=ttyHW0,115200 console=tty0 ignore_loglevel loglevel=8 nokaslr";
		stdout-path = "serial0:115200n8";
		linux,initrd-start = <0x0 0x66800000>;
		linux,initrd-end = <0x0 0x66800000>;
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x400000 0x0 0xbffa0000>;
	};
};
